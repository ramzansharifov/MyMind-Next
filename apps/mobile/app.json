{
  "expo": {
    "name": "MyMind",
    "slug": "mymind-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mymind.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "mymind",
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "MyMind использует выбранные вами фотографии для локального дневника прогресса.",
          "cameraPermission": "MyMind использует камеру для фотографий прогресса.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
