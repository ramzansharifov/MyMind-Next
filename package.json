{
  "name": "mymind",
  "version": "1.0.0",
  "private": true,
  "description": "MyMind local-first Desktop and PWA monorepo",
  "workspaces": [
    "apps/desktop",
    "apps/pwa",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace=mymind-next && npm run lint:pwa && npm run lint:packages",
    "typecheck:packages": "npm run typecheck --workspace=@mymind/contracts && npm run typecheck --workspace=@mymind/core && npm run typecheck --workspace=@mymind/design && npm run typecheck --workspace=@mymind/persistence",
    "typecheck:desktop": "npm run typecheck --workspace=mymind-next",
    "typecheck": "npm run typecheck:packages && npm run typecheck:desktop && npm run typecheck:pwa",
    "start": "npm run start --workspace=mymind-next",
    "preview:existing": "npm run preview:existing --workspace=mymind-next",
    "dev": "npm run dev:desktop",
    "dev:desktop": "npm run dev --workspace=mymind-next",
    "dev:pwa": "node apps/pwa/scripts/prepare-assets.mjs && npm run dev --workspace=mymind-pwa",
    "build:pwa": "npm run build --workspace=mymind-pwa",
    "start:pwa": "npm run start --workspace=mymind-pwa",
    "start:pwa:lan": "node apps/pwa/scripts/start-lan.mjs",
    "dev:pwa:lan": "node apps/pwa/scripts/prepare-assets.mjs && node apps/pwa/scripts/start-lan.mjs --dev",
    "typecheck:pwa": "npm run typecheck --workspace=mymind-pwa",
    "test:pwa": "npm run test --workspace=mymind-pwa",
    "test:e2e:pwa": "playwright test --config apps/pwa/playwright.config.mts",
    "lint:pwa": "eslint apps/pwa",
    "check:pwa": "npm run lint:pwa && npm run typecheck:pwa && npm run test:pwa && npm run build:pwa",
    "build:bundle": "npm run build:bundle --workspace=mymind-next",
    "build": "npm run build --workspace=mymind-next",
    "build:unpack": "npm run build:unpack --workspace=mymind-next",
    "build:win": "npm run build:win --workspace=mymind-next",
    "release:win": "npm run release:win --workspace=mymind-next",
    "build:mac": "npm run build:mac --workspace=mymind-next",
    "build:linux": "npm run build:linux --workspace=mymind-next",
    "native:node": "npm run native:node --workspace=mymind-next",
    "native:electron": "npm run native:electron --workspace=mymind-next",
    "rebuild:native": "npm run rebuild:native --workspace=mymind-next",
    "db:generate": "npm run db:generate --workspace=mymind-next",
    "db:check": "npm run db:check --workspace=mymind-next",
    "db:migrate": "npm run db:migrate --workspace=mymind-next",
    "db:studio": "npm run db:studio --workspace=mymind-next",
    "test": "npm run test --workspace=mymind-next",
    "test:run": "npm run test:run --workspace=mymind-next",
    "test:coverage": "npm run test:coverage --workspace=mymind-next",
    "check": "npm run typecheck:packages && npm run lint:packages && npm run test:release && npm run check --workspace=mymind-next && npm run check:pwa",
    "check:fix": "npm run format && npm run check",
    "release:version": "node ./scripts/set-release-version.mjs",
    "lint:packages": "eslint packages",
    "test:release": "node --test scripts/set-release-version.test.mjs"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true,
    "electron@44.2.0": true,
    "electron-winstaller@5.4.0": true
  }
}
